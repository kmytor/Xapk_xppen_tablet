<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#121212">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- 3 Column Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- ════════ COLUMN 1: Motor Autónomo + Accesibilidad ════════ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="6dp">

            <!-- Motor Autónomo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Motor Autónomo"
                android:textColor="#03DAC5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tv_daemon_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Estado: Motor Inactivo"
                        android:textColor="#FFC107"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                    <Button
                        android:id="@+id/btn_open_wireless"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="Abrir Dep. Inalámbrica"
                        android:textColor="#000000"
                        android:textSize="11sp"
                        android:backgroundTint="#03DAC5"/>

                    <EditText
                        android:id="@+id/et_wireless_host"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:hint="IP tableta"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#757575"
                        android:textSize="12sp"
                        android:inputType="text"
                        android:background="#2A2A2A"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_marginTop="4dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <EditText
                            android:id="@+id/et_pair_port"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:hint="Puerto pairing"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#757575"
                            android:textSize="11sp"
                            android:inputType="number"
                            android:background="#2A2A2A"
                            android:paddingStart="6dp"
                            android:paddingEnd="4dp"
                            android:layout_marginEnd="3dp"/>

                        <EditText
                            android:id="@+id/et_connect_port"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:hint="Puerto conexión"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#757575"
                            android:textSize="11sp"
                            android:inputType="number"
                            android:background="#2A2A2A"
                            android:paddingStart="6dp"
                            android:paddingEnd="4dp"/>
                    </LinearLayout>

                    <EditText
                        android:id="@+id/et_pair_code"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:hint="Código 6 dígitos"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#757575"
                        android:textSize="12sp"
                        android:inputType="number"
                        android:background="#2A2A2A"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_marginTop="4dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <Button
                            android:id="@+id/btn_pair_daemon"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="Emparejar"
                            android:textColor="#000000"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:backgroundTint="#03DAC5"
                            android:layout_marginEnd="3dp"/>

                        <Button
                            android:id="@+id/btn_connect_daemon"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="Reconectar"
                            android:textColor="#000000"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:backgroundTint="#4CAF50"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Accesibilidad -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Accesibilidad"
                android:textColor="#FFD54F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <Button
                        android:id="@+id/btn_accessibility"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="Abrir Accesibilidad"
                        android:textColor="#121212"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:backgroundTint="#FFD54F"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ════════ COLUMN 2: Stylus Pen ════════ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stylus Pen"
                android:textColor="#BB86FC"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Pressure Curve -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pressure Curve"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp"
                        android:layout_marginBottom="2dp"/>
                    <Spinner
                        android:id="@+id/spinner_pressure_curve"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:backgroundTint="#FFFFFF"
                        android:popupBackground="#1E1E1E"
                        android:layout_marginBottom="8dp"/>

                    <!-- Sensitivity -->
                    <TextView
                        android:id="@+id/tv_sensitivity_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sensitivity: 50%"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp"
                        android:layout_marginBottom="2dp"/>
                    <SeekBar
                        android:id="@+id/seek_sensitivity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="50"
                        android:thumbTint="#BB86FC"
                        android:progressTint="#BB86FC"
                        android:layout_marginBottom="8dp"/>

                    <!-- Button 1 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Button 1 (Lower)"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp"
                        android:layout_marginBottom="2dp"/>
                    <Spinner
                        android:id="@+id/spinner_button1_action"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:backgroundTint="#FFFFFF"
                        android:popupBackground="#1E1E1E"
                        android:layout_marginBottom="8dp"/>

                    <!-- Button 2 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Button 2 (Upper)"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp"
                        android:layout_marginBottom="2dp"/>
                    <Spinner
                        android:id="@+id/spinner_button2_action"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:backgroundTint="#FFFFFF"
                        android:popupBackground="#1E1E1E"
                        android:layout_marginBottom="8dp"/>

                    <!-- Hover -->
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_hover"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="Stylus Hovering"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        app:thumbTint="#BB86FC"
                        app:trackTint="#66BB86FC"
                        android:layout_marginBottom="2dp"/>

                    <!-- Cursor -->
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_cursor"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="Virtual Cursor"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        app:thumbTint="#BB86FC"
                        app:trackTint="#66BB86FC"
                        android:layout_marginBottom="2dp"/>

                    <!-- Auto-connect -->
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_auto_connect"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="USB Auto-connect"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        app:thumbTint="#BB86FC"
                        app:trackTint="#66BB86FC"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ════════ COLUMN 3: Tablet & Mapping + Actions ════════ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tablet &amp; Mapping"
                android:textColor="#03DAC6"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Rotation -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Orientation / Rotation"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp"
                        android:layout_marginBottom="2dp"/>
                    <Spinner
                        android:id="@+id/spinner_rotation"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:backgroundTint="#FFFFFF"
                        android:popupBackground="#1E1E1E"
                        android:layout_marginBottom="8dp"/>

                    <!-- Input Mode -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Input Mode"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp"
                        android:layout_marginBottom="2dp"/>
                    <Spinner
                        android:id="@+id/spinner_input_mode"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:backgroundTint="#FFFFFF"
                        android:popupBackground="#1E1E1E"
                        android:layout_marginBottom="8dp"/>

                    <!-- Area Mode -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active Area Mode"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp"
                        android:layout_marginBottom="2dp"/>
                    <Spinner
                        android:id="@+id/spinner_area_mode"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:backgroundTint="#FFFFFF"
                        android:popupBackground="#1E1E1E"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_reset"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Reset"
                    android:textColor="#FF5555"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="3dp"/>

                <Button
                    android:id="@+id/btn_save"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Save &amp; Apply"
                    android:backgroundTint="#BB86FC"
                    android:textColor="#121212"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginStart="3dp"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
